# Copiar a .env y rellenar. install.sh lo genera automáticamente durante la instalación.

# --- Base de datos ---
# Ruta relativa a prisma/schema.prisma. En Docker el volumen se monta en
# /app/data y este valor apunta ahí igualmente (../data == /app/data).
DATABASE_URL="file:../data/tintas.db"

# --- Excel compartido (ruta DENTRO del contenedor poller, tras el bind-mount del CIFS) ---
EXCEL_PATH="/mnt/yaiza-paty/TintaImpresoras.xlsx"

# --- Sesiones ---
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# --- Sondeo SNMP y sincronización ---
POLL_INTERVAL_MS=300000
EXCEL_SYNC_INTERVAL_MS=600000
INK_THRESHOLD_PERCENT=20
REORDER_XL_AND_NORMAL=true

# --- Email ---
# EMAIL_PROVIDER: none | smtp | graph
EMAIL_PROVIDER=none
EMAIL_TO=tecnologia@pgoucam.com

# SMTP (si EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tintas Auto <tintas-auto@pgoucam.com>"

# Microsoft Graph (si EMAIL_PROVIDER=graph)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=tecnologia@pgoucam.com

# --- Web ---
PORT=3000
